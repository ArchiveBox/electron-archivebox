{
  "name": "electron-archivebox",
  "version": "0.6.2",
  "description": "Desktop Electron app for the ArchiveBox internet archiver",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "lint": "eslint .",
    "smoke-test": "node scripts/smoke-test.js",
    "capture-screenshots": "node scripts/capture-screenshots.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.0"
  },
  "repository": "https://github.com/ArchiveBox/electron-archivebox",
  "keywords": [
    "ArchiveBox",
    "internet",
    "archiving",
    "GUI",
    "desktop",
    "web"
  ],
  "author": "Nick Sweeting",
  "license": "AGPL v2",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^44.4.2",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "electron-squirrel-startup": "^1.0.1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "archivebox"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
